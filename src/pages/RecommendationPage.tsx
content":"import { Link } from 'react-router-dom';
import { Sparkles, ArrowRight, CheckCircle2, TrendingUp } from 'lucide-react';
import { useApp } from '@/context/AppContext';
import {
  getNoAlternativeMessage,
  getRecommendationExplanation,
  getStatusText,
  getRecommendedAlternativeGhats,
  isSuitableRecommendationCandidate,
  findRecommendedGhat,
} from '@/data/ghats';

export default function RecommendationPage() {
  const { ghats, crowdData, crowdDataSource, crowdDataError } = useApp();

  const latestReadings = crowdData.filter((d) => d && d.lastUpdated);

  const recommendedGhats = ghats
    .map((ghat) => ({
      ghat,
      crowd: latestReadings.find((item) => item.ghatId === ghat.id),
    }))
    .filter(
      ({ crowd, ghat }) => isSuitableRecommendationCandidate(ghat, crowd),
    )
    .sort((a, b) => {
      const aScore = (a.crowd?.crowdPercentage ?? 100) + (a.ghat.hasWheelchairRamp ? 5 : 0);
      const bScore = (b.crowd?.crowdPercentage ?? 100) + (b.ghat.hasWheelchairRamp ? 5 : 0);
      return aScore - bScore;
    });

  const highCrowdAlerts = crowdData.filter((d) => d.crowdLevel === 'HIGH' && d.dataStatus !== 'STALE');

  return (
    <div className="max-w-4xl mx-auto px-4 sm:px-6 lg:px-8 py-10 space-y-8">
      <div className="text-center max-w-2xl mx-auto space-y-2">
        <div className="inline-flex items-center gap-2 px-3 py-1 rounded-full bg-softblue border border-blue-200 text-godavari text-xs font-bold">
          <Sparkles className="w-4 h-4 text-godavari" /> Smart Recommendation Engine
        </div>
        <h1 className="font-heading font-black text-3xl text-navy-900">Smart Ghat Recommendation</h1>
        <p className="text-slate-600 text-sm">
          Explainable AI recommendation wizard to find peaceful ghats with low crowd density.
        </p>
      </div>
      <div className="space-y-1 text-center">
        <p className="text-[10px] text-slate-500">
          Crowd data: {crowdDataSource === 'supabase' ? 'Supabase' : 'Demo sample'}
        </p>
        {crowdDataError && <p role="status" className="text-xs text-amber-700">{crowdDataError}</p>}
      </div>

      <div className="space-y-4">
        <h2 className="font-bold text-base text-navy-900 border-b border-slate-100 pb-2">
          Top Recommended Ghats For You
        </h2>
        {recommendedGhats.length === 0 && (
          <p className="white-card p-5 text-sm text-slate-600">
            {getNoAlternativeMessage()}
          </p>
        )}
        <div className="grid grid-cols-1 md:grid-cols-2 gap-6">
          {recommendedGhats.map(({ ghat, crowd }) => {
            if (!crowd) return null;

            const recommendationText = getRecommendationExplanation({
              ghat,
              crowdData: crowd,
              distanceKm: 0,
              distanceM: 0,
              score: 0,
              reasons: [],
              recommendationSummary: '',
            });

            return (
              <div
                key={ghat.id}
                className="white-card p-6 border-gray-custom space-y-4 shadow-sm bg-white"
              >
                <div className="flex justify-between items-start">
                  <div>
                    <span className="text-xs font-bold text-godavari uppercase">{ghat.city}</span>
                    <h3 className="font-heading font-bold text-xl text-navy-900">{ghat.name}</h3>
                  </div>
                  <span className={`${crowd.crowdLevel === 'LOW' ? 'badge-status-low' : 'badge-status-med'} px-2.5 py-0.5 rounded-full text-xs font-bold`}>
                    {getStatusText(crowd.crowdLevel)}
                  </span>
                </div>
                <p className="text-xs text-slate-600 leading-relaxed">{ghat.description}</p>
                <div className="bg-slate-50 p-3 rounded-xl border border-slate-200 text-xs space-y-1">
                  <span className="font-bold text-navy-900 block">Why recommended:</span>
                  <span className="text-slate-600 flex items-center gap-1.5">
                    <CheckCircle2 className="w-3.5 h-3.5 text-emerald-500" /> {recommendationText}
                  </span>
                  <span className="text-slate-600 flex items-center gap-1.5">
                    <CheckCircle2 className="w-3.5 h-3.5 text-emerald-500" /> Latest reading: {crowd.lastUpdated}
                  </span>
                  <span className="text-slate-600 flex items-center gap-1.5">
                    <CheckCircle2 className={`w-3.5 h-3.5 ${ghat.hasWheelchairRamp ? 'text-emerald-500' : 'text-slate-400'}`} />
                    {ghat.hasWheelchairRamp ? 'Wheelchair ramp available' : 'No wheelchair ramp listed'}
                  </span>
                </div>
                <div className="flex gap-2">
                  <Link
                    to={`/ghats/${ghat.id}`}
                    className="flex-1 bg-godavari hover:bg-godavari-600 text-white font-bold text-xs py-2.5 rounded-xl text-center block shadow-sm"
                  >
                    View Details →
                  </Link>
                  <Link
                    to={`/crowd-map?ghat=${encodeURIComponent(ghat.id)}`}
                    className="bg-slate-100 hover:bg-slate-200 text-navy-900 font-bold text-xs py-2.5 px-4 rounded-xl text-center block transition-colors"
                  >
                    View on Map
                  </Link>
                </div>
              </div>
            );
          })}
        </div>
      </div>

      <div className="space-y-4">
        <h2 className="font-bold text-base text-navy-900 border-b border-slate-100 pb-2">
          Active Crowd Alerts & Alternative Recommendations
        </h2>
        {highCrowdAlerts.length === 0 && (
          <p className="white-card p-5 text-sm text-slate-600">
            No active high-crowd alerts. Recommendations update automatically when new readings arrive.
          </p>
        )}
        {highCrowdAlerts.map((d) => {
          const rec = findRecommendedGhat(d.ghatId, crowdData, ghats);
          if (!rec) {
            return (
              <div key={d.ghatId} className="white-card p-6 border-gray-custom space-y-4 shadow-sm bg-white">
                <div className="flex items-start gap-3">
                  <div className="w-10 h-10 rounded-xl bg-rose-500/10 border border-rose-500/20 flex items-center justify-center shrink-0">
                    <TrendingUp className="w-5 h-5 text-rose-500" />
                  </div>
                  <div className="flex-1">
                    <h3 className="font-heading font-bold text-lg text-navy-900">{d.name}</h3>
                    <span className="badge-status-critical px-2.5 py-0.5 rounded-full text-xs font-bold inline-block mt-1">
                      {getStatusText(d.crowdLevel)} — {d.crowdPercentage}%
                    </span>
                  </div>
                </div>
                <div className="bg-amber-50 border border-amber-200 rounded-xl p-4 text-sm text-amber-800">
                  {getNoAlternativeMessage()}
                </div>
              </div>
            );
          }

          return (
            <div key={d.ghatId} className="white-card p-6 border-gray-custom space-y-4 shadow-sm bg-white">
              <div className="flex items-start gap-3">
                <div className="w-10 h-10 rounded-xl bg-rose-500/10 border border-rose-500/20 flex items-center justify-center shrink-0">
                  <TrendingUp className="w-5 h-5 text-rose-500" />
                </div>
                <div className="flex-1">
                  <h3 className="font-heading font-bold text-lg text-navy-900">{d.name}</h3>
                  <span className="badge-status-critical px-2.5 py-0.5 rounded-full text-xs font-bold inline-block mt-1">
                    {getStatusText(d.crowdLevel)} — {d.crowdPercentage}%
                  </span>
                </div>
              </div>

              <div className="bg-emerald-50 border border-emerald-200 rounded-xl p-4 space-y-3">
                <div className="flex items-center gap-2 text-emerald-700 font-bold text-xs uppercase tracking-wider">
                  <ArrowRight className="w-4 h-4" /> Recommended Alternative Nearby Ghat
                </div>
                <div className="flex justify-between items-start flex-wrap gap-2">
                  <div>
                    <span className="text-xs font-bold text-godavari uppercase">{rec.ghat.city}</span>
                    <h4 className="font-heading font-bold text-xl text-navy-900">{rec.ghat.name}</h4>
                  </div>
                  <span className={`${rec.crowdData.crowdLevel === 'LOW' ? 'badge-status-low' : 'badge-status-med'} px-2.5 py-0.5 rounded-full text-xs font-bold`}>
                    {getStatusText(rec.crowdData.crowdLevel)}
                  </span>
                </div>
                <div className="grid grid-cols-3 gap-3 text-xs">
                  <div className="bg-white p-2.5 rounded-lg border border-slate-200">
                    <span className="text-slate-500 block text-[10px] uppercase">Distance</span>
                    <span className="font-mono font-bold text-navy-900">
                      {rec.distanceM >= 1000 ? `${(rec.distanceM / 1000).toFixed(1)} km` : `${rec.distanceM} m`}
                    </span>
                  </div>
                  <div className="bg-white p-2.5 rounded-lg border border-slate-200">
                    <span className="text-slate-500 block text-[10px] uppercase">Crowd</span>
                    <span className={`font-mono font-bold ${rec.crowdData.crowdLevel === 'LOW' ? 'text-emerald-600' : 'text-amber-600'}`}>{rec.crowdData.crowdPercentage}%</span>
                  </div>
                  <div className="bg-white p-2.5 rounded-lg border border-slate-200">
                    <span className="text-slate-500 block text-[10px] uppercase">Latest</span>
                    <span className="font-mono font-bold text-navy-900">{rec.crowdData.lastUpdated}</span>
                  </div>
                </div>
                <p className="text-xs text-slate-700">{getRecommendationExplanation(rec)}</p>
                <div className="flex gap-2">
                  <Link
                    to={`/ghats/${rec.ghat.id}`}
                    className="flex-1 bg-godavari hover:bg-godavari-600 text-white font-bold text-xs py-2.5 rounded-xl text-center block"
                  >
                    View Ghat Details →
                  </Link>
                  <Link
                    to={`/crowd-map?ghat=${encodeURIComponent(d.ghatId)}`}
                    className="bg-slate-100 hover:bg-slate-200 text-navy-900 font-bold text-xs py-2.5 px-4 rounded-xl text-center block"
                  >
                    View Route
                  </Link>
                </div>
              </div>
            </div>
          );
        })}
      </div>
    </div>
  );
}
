export function getDemoCrowdData(ghatList: Ghat[] = ghats): GhatCrowdData[] {
  return ghatList.map((g) => {
    const pct = demoCrowdPercentages[g.id] ?? 50;
    const activePilgrims = Math.max(0, Math.round((pct / 100) * g.effectiveCapacity));
    const crowdPercentage = Number(
      calculateOccupancyPercentage(activePilgrims, g.effectiveCapacity).toFixed(1),
    );
    const crowdLevel = getCrowdLevel(crowdPercentage);
    const riskLevel = getRiskLevel(crowdLevel);
    return {
      ghatId: g.id,
      name: g.name,
      latitude: g.latitude,
      longitude: g.longitude,
      crowdPercentage,
      crowdLevel,
      riskLevel,
      status: getStatusText(crowdLevel),
      recommendation: getRecommendationText(crowdLevel),
      activePilgrims,
      entryThroughput: demoEntryThroughput[g.id] ?? 6000,
      exitThroughput: demoExitThroughput[g.id] ?? 5500,
      lastUpdated: new Date().toLocaleTimeString('en-IN', {
        hour: '2-digit',
        minute: '2-digit',
      }),
      dataStatus: 'DEMO',
    };
  });
}

export function haversineDistance(
  lat1: number,
  lng1: number,
  lat2: number,
  lng2: number,
): number {
  const R = 6371;
  const dLat = ((lat2 - lat1) * Math.PI) / 180;
  const dLng = ((lng2 - lng1) * Math.PI) / 180;
  const a =
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos((lat1 * Math.PI) / 180) *
      Math.cos((lat2 * Math.PI) / 180) *
      Math.sin(dLng / 2) *
      Math.sin(dLng / 2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  return R * c;
}

export function getDirectionsUrl(
  fromLat: number,
  fromLng: number,
  toLat: number,
  toLng: number,
): string {
  return `https://www.openstreetmap.org/directions?from=${fromLat}%2C${fromLng}&to=${toLat}%2C${toLng}`;
}

export function getRecommendedAlternativeGhats(
  currentGhatId: string,
  allCrowdData: GhatCrowdData[],
  ghatList: Ghat[] = ghats,
): RecommendedGhat[] {
  const latestReadings = getLatestValidCrowdData(allCrowdData);
  const currentCrowd = latestReadings.find((d) => d.ghatId === currentGhatId);
  if (!currentCrowd || currentCrowd.crowdLevel !== 'HIGH') return [];

  const candidates: RecommendedGhat[] = latestReadings
    .filter((d) => d.ghatId !== currentGhatId)
    .map((d) => {
      const ghat = ghatList.find((item) => item.id === d.ghatId);
      if (!ghat) return null;
      if (d.crowdLevel === 'HIGH') return null;
      if (d.crowdPercentage >= 80 || d.activePilgrims >= ghat.effectiveCapacity || d.dataStatus === 'STALE') {
        return null;
      }

      const distanceKm = haversineDistance(
        currentCrowd.latitude,
        currentCrowd.longitude,
        ghat.latitude,
        ghat.longitude,
      );
      const distanceM = Math.round(distanceKm * 1000);
      const accessibilityScore = (ghat.hasWheelchairRamp ? 10 : 0) + (ghat.hasParking ? 4 : 0);
      const crowdScore = Math.max(0, 100 - d.crowdPercentage) * 1.4;
      const capacityScore = Math.min(30, ghat.effectiveCapacity / 1500);
      const distanceScore = Math.max(0, 30 - distanceKm * 2.2);
      const score = crowdScore + capacityScore + accessibilityScore + distanceScore;

      return {
        ghat,
        crowdData: d,
        distanceKm,
        distanceM,
        score,
        reasons: [
          `Crowd level: ${getStatusText(d.crowdLevel)}`,
          `Latest reading: ${d.lastUpdated}`,
          `Occupancy: ${d.crowdPercentage.toFixed(1)}%`,
          `Effective capacity: ${ghat.effectiveCapacity.toLocaleString()} pilgrims`,
          ghat.hasWheelchairRamp ? 'Accessibility: wheelchair ramp available' : 'Accessibility: no wheelchair ramp listed',
          distanceM >= 1000 ? `Distance: ${distanceKm.toFixed(1)} km away` : `Distance: ${distanceM} m away`,
        ],
        recommendationSummary:
          `${ghat.name} is a ${d.crowdLevel.toLowerCase()} crowd option with ${d.crowdPercentage.toFixed(1)}% occupancy and a fresh reading at ${d.lastUpdated}.`,
      };
    })
    .filter((candidate): candidate is RecommendedGhat => candidate !== null)
    .sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      if (a.distanceKm !== b.distanceKm) return a.distanceKm - b.distanceKm;
      if (a.crowdData.crowdPercentage !== b.crowdData.crowdPercentage) {
        return a.crowdData.crowdPercentage - b.crowdData.crowdPercentage;
      }
      return a.ghat.name.localeCompare(b.ghat.name);
    });

  return candidates;
}

export function isSuitableRecommendationCandidate(
  ghat: Ghat,
  crowdData: GhatCrowdData | undefined,
): crowdData is GhatCrowdData {
  if (!crowdData) return false;
  if (!isValidCrowdReading(crowdData)) return false;
  if (crowdData.crowdLevel === 'HIGH') return false;
  if (crowdData.crowdPercentage >= 80) return false;
  if (crowdData.activePilgrims >= ghat.effectiveCapacity) return false;
  return true;
}

export function getRecommendationExplanation(recommended: RecommendedGhat): string {
  return `${recommended.ghat.name} is recommended because it is ${recommended.crowdData.crowdLevel.toLowerCase()} crowd (${recommended.crowdData.crowdPercentage.toFixed(1)}% occupancy), has a fresh reading at ${recommended.crowdData.lastUpdated}, and is ${recommended.distanceM >= 1000 ? `${(recommended.distanceKm).toFixed(1)} km` : `${recommended.distanceM} m`} away${recommended.ghat.hasWheelchairRamp ? ' with a wheelchair ramp available' : ' with no wheelchair ramp listed'}.`;
}

export function getNoAlternativeMessage(): string {
  return 'No reliable alternative is currently available. All nearby ghats are full, unsafe, stale, or missing valid readings.';
}

export function getRecommendedGhatSummary(recommended: RecommendedGhat | null): string {
  if (!recommended) return getNoAlternativeMessage();
  return getRecommendationExplanation(recommended);
}

export function findRecommendedHighCrowdAlternative(
  currentGhatId: string,
  allCrowdData: GhatCrowdData[],
  ghatList: Ghat[] = ghats,
): RecommendedGhat | null {
  return findRecommendedGhat(currentGhatId, allCrowdData, ghatList);
}

export function validateRecommendationScenario(
  currentGhatId: string,
  allCrowdData: GhatCrowdData[],
  ghatList: Ghat[] = ghats,
): { count: number; hasReliable: boolean; recommendation: RecommendedGhat | null } {
  const recommendation = findRecommendedGhat(currentGhatId, allCrowdData, ghatList);
  const alternatives = getRecommendedAlternativeGhats(currentGhatId, allCrowdData, ghatList);
  return {
    count: alternatives.length,
    hasReliable: Boolean(recommendation),
    recommendation,
  };
}

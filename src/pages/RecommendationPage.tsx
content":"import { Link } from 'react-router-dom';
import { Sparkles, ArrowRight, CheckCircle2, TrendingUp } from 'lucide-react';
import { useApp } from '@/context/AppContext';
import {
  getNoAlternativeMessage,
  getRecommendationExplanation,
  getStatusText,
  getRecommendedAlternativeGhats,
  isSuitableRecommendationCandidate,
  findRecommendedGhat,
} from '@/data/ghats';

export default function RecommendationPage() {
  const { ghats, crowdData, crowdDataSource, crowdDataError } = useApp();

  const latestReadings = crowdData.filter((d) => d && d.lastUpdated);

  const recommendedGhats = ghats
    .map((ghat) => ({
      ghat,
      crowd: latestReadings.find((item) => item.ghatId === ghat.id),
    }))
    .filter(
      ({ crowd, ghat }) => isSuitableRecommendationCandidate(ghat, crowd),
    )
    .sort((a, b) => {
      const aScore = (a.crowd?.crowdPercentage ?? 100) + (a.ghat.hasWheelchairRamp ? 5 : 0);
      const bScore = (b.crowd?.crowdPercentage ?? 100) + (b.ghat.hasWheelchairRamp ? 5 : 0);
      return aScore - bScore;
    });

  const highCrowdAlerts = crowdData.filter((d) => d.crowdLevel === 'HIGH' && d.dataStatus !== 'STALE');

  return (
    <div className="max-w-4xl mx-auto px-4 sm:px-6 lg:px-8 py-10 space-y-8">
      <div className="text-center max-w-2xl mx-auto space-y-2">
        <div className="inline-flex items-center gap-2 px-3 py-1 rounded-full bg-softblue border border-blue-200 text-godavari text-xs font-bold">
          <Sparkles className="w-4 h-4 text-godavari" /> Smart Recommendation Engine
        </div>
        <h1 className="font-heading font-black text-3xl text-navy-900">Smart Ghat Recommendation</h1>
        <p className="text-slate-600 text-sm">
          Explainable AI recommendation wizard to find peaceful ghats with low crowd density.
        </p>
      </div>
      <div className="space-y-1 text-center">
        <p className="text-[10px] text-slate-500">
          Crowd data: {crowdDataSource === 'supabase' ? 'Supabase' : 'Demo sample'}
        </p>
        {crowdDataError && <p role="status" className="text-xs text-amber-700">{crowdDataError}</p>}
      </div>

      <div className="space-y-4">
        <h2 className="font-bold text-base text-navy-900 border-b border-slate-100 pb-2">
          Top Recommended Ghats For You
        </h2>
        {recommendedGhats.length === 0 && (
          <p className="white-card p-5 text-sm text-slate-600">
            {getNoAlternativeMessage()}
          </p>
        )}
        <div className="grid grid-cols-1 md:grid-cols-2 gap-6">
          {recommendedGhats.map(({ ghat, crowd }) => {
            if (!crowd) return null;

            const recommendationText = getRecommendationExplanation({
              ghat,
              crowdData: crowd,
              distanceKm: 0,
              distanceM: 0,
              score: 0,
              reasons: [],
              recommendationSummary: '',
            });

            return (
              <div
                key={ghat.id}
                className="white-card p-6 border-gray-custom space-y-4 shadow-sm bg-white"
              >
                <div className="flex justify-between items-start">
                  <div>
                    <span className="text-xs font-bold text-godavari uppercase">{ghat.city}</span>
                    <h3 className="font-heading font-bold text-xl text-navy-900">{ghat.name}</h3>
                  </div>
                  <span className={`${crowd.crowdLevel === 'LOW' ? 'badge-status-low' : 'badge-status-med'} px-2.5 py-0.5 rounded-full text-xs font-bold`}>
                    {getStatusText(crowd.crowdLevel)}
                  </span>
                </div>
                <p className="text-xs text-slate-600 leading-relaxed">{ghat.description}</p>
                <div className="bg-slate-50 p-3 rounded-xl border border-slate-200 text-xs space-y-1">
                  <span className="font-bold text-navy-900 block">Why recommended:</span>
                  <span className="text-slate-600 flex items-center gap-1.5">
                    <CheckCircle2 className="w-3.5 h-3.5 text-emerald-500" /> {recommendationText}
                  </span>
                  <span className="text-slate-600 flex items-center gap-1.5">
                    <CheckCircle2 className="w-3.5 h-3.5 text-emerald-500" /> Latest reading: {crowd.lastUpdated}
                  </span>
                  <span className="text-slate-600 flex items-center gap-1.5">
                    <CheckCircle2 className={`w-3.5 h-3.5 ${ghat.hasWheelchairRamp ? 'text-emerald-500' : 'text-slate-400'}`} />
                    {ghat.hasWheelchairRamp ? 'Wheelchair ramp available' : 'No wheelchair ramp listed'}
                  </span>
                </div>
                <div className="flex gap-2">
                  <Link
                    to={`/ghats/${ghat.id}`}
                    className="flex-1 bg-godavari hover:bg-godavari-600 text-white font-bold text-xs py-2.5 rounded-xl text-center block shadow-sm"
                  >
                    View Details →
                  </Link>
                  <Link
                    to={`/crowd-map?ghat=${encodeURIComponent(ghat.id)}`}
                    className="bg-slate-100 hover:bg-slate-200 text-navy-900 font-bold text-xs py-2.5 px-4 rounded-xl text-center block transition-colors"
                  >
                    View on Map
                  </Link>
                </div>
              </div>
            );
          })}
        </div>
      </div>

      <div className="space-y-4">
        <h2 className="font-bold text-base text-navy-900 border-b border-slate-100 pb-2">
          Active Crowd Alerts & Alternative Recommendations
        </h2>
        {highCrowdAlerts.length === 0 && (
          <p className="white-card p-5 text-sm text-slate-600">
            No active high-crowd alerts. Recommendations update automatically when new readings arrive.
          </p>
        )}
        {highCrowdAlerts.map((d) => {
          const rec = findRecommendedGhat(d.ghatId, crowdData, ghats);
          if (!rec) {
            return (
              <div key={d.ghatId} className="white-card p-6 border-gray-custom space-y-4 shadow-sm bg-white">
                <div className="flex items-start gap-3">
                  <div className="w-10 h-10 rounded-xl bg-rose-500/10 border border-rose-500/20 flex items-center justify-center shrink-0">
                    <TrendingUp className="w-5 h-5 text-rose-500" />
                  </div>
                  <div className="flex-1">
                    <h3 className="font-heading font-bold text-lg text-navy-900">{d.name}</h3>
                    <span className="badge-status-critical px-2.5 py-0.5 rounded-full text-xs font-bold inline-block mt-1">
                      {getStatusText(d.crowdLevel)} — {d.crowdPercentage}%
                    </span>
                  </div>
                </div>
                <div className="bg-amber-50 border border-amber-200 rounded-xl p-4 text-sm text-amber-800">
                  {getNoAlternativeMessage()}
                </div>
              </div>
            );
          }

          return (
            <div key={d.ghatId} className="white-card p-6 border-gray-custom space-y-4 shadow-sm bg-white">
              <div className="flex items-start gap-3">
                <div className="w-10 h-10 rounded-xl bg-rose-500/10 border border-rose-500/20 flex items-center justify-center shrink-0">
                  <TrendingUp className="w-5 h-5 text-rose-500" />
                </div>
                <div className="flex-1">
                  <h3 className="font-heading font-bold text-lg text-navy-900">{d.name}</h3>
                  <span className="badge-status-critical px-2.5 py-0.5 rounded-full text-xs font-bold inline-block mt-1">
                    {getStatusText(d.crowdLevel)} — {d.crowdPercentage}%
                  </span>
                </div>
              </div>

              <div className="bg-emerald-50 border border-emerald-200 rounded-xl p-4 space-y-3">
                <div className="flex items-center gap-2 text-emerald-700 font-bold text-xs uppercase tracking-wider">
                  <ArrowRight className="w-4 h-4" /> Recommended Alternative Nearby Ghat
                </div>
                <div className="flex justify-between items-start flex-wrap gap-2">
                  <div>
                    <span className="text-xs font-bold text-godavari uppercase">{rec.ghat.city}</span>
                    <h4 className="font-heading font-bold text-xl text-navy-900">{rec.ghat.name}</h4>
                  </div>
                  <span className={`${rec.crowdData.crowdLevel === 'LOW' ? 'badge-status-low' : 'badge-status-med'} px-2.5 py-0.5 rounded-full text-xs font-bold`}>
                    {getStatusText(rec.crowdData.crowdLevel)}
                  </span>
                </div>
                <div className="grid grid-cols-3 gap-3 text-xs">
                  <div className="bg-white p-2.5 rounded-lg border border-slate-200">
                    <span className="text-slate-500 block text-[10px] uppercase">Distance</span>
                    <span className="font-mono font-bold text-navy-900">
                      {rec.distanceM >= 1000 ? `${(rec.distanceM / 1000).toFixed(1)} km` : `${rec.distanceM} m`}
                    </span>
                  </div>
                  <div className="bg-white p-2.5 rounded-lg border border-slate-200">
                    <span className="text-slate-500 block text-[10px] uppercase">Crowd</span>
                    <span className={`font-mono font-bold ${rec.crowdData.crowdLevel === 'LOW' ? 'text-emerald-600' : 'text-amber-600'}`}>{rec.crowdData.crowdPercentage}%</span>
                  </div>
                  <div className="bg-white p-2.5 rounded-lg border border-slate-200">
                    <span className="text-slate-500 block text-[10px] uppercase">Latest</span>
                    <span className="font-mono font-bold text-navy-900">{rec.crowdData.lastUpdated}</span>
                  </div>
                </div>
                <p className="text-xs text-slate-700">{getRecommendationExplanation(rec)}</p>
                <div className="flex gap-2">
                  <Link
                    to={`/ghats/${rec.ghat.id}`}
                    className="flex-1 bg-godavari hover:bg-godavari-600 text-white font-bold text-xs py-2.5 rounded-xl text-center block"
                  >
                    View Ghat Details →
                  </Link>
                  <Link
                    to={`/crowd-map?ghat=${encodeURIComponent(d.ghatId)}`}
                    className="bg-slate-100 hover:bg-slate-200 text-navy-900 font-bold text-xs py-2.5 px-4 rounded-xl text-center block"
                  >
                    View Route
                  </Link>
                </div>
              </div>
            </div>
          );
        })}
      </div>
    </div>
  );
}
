export interface Ghat {
  id: string;
  name: string;
  city: string;
  district: string;
  latitude: number;
  longitude: number;
  physicalCapacity: number;
  effectiveCapacity: number;
  generalTicketPrice: number;
  vipTicketPrice: number;
  hasWheelchairRamp: boolean;
  hasParking: boolean;
  image: string;
  description: string;
}

export type CrowdLevel = 'LOW' | 'MODERATE' | 'HIGH';
export type RiskLevel = 'SAFE' | 'MODERATE' | 'HIGH';
export type CrowdDataStatus = 'LIVE' | 'DEMO' | 'STALE';

export interface GhatCrowdData {
  ghatId: string;
  name: string;
  latitude: number;
  longitude: number;
  crowdPercentage: number;
  crowdLevel: CrowdLevel;
  riskLevel: RiskLevel;
  status: string;
  recommendation: string;
  activePilgrims: number;
  entryThroughput: number;
  exitThroughput: number;
  lastUpdated: string;
  dataStatus: CrowdDataStatus;
}

export const THRESHOLDS = {
  LOW: 40,
  MODERATE: 70,
};

export const CROWD_DATA_FRESHNESS_LIMIT_MS = 5 * 60 * 1000;

export function calculateOccupancyPercentage(occupancy: number, effectiveCapacity: number): number {
  if (!Number.isFinite(occupancy) || occupancy < 0) {
    throw new Error(`Invalid occupancy reading: ${occupancy}`);
  }
  if (!Number.isFinite(effectiveCapacity) || effectiveCapacity <= 0) {
    throw new Error(`Invalid effective capacity: ${effectiveCapacity}`);
  }

  const percentage = (occupancy / effectiveCapacity) * 100;
  if (!Number.isFinite(percentage) || percentage < 0) {
    throw new Error(`Occupancy percentage could not be calculated for ${occupancy}/${effectiveCapacity}`);
  }

  return Math.min(100, Math.max(0, percentage));
}

export function getCrowdLevel(percentage: number): CrowdLevel {
  if (percentage < THRESHOLDS.LOW) return 'LOW';
  if (percentage <= THRESHOLDS.MODERATE) return 'MODERATE';
  return 'HIGH';
}

export function getRiskLevel(crowdLevel: CrowdLevel): RiskLevel {
  switch (crowdLevel) {
    case 'LOW':
      return 'SAFE';
    case 'MODERATE':
      return 'MODERATE';
    case 'HIGH':
      return 'HIGH';
  }
}

export function getStatusText(crowdLevel: CrowdLevel): string {
  switch (crowdLevel) {
    case 'LOW':
      return '🟢 Safe / Low Crowd';
    case 'MODERATE':
      return '🟠 Moderate Crowd';
    case 'HIGH':
      return '🔴 High Crowd / High Risk';
  }
}

export function getRecommendationText(crowdLevel: CrowdLevel): string {
  switch (crowdLevel) {
    case 'LOW':
      return 'Safe to proceed — ideal for bathing and rituals';
    case 'MODERATE':
      return 'Exercise caution — expect moderate waiting times';
    case 'HIGH':
      return 'Avoid — nearby safer ghat available';
  }
}

export function getCrowdDataStatus(
  source: 'demo' | 'supabase',
  lastUpdated?: string | null,
): CrowdDataStatus {
  if (source === 'demo') return 'DEMO';

  if (!lastUpdated) return 'STALE';

  const lastUpdatedTime = new Date(lastUpdated).getTime();
  if (Number.isNaN(lastUpdatedTime)) return 'STALE';

  return Date.now() - lastUpdatedTime > CROWD_DATA_FRESHNESS_LIMIT_MS ? 'STALE' : 'LIVE';
}

export function getCrowdDataSourceLabel(status: CrowdDataStatus): string {
  switch (status) {
    case 'LIVE':
      return 'LIVE';
    case 'STALE':
      return 'STALE';
    case 'DEMO':
      return 'DEMO';
  }
}

export function isValidCrowdReading(payload: GhatCrowdData | undefined | null): payload is GhatCrowdData {
  if (!payload) return false;
  if (!Number.isFinite(payload.crowdPercentage) || payload.crowdPercentage < 0 || payload.crowdPercentage > 100) {
    return false;
  }
  if (!payload.lastUpdated || Number.isNaN(new Date(payload.lastUpdated).getTime())) {
    return false;
  }
  return payload.dataStatus !== 'STALE';
}

export function getLatestValidCrowdData(allCrowdData: GhatCrowdData[]): GhatCrowdData[] {
  const latestByGhat = new Map<string, GhatCrowdData>();

  for (const item of allCrowdData) {
    if (!isValidCrowdReading(item)) continue;
    const existing = latestByGhat.get(item.ghatId);
    if (!existing) {
      latestByGhat.set(item.ghatId, item);
      continue;
    }

    const existingTs = new Date(existing.lastUpdated).getTime();
    const currentTs = new Date(item.lastUpdated).getTime();
    if (Number.isNaN(currentTs) || Number.isNaN(existingTs) || currentTs >= existingTs) {
      latestByGhat.set(item.ghatId, item);
    }
  }

  return Array.from(latestByGhat.values());
}

export interface RecommendedGhat {
  ghat: Ghat;
  crowdData: GhatCrowdData;
  distanceKm: number;
  distanceM: number;
  score: number;
  reasons: string[];
  recommendationSummary: string;
}

export function findRecommendedGhat(
  currentGhatId: string,
  allCrowdData: GhatCrowdData[],
  ghatList: Ghat[] = ghats,
): RecommendedGhat | null {
  const currentGhat = ghatList.find((g) => g.id === currentGhatId);
  const latestReadings = getLatestValidCrowdData(allCrowdData);
  const currentCrowd = latestReadings.find((d) => d.ghatId === currentGhatId);

  if (!currentGhat || !currentCrowd) return null;
  if (currentCrowd.crowdLevel !== 'HIGH') return null;

  const candidates = latestReadings
    .filter((d) => d.ghatId !== currentGhatId)
    .map((d) => {
      const ghat = ghatList.find((gg) => gg.id === d.ghatId);
      if (!ghat) return null;

      const isFull = d.activePilgrims >= ghat.effectiveCapacity;
      const isUnsafe = d.crowdLevel === 'HIGH' || d.crowdPercentage >= 80;
      const isMissingOrInvalid = !isValidCrowdReading(d);
      const isStale = d.dataStatus === 'STALE';

      if (isMissingOrInvalid || isFull || isUnsafe || isStale) {
        return null;
      }

      const distanceKm = haversineDistance(
        currentGhat.latitude,
        currentGhat.longitude,
        ghat.latitude,
        ghat.longitude,
      );
      const distanceM = Math.round(distanceKm * 1000);

      const accessibilityScore = (ghat.hasWheelchairRamp ? 10 : 0) + (ghat.hasParking ? 4 : 0);
      const crowdScore = Math.max(0, 100 - d.crowdPercentage) * 1.4;
      const effectiveCapacityScore = Math.min(30, ghat.effectiveCapacity / 1500);
      const distanceScore = Math.max(0, 30 - distanceKm * 2.2);
      const score = crowdScore + effectiveCapacityScore + accessibilityScore + distanceScore;

      const reasons = [
        `Crowd level: ${getStatusText(d.crowdLevel)}`,
        `Latest reading: ${d.lastUpdated}`,
        `Occupancy: ${d.crowdPercentage.toFixed(1)}%`,
        `Effective capacity: ${ghat.effectiveCapacity.toLocaleString()} pilgrims`,
      ];

      if (ghat.hasWheelchairRamp) {
        reasons.push('Accessibility: wheelchair ramp available');
      } else {
        reasons.push('Accessibility: no wheelchair ramp listed');
      }

      if (distanceM >= 1000) {
        reasons.push(`Distance: ${(distanceKm).toFixed(1)} km away`);
      } else {
        reasons.push(`Distance: ${distanceM} m away`);
      }

      return {
        ghat,
        crowdData: d,
        distanceKm,
        distanceM,
        score,
        reasons,
        recommendationSummary:
          `${ghat.name} is a ${d.crowdLevel.toLowerCase()} crowd option with ${d.crowdPercentage.toFixed(1)}% occupancy and a fresh reading at ${d.lastUpdated}.`,
      };
    })
    .filter((candidate): candidate is RecommendedGhat => candidate !== null)
    .sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      if (a.distanceKm !== b.distanceKm) return a.distanceKm - b.distanceKm;
      if (a.crowdData.crowdPercentage !== b.crowdData.crowdPercentage) {
        return a.crowdData.crowdPercentage - b.crowdData.crowdPercentage;
      }
      return a.ghat.name.localeCompare(b.ghat.name);
    });

  return candidates[0] ?? null;
}

